model Schedule {
    id  string          @id     @default(uuid(7))
    startDate           DateTime
    endDate             DateTime
    startTime           DateTime
    endTime             DateTime
    createdAt           DateTime
    updatedAt           DateTime
    doctorSchedules     DoctorSchedules[]
    appointments        Appointments[]

    @@map("schedules")
}

model DoctorSchedules {
    doctorId            String
    doctor              Doctor      @relation(fields: [doctorId], reference: [id], onDelete: Cascade, onUpdate: Cascade)

    scheduleId          String
    schedule            Schedule    @relation(fields: [scheduleId], reference: [id],
    onDelete: Cascade, onUpdate: Cascade)

    isBooked            Boolean     @default(false)
    createdAt           DateTime    @default(now())
    updatedAt           DateTime    @updatedAt

    @@id([doctorId, scheduleId])
    @@index([doctorId])
    @@index([scheduleId])
    @@map("doctor_schedules")
}